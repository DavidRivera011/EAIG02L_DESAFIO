<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101B2D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Encabezado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTROLGIRO"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <!-- Configuración de conexión -->
        <EditText
            android:id="@+id/etArduinoIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="IP del Arduino (ej. 192.168.1.100)"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#B7C7DD"
            android:backgroundTint="#B7C7DD"
            android:padding="12dp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnConectar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CONECTAR CON ARDUINO"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:backgroundTint="#286B52" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ARDUINO UNO R4 WIFI"
            android:textColor="#B7C7DD"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />

        <!-- Escudo: espacio reservado -->
        <TextView
            android:id="@+id/txtBarcelona"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FC BARCELONA"
            android:textColor="#F5C542"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:layout_marginTop="12dp" />

        <!-- Estado de conexión -->
        <TextView
            android:id="@+id/txtConexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wi-Fi: desconectado"
            android:textColor="#FFCC80"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="12dp"
            android:background="#25364F"
            android:layout_marginTop="12dp" />

        <!-- Lectura del sensor -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISTANCIA DEL SENSOR"
            android:textColor="#B7C7DD"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/txtDistancia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--- cm"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="24dp"
            android:background="#25364F"
            android:layout_marginTop="8dp" />

        <!-- Control manual -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTROL MANUAL"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnIzquierda"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="← IZQUIERDA"
                android:textSize="12sp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#174E83" />

            <Button
                android:id="@+id/btnDerecha"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="DERECHA →"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#174E83" />

        </LinearLayout>

        <Button
            android:id="@+id/btnDetener"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="■  DETENER MOTOR"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:backgroundTint="#A52643" />

        <!-- Control automático -->
        <Button
            android:id="@+id/btnAutomatico"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ACTIVAR MODO AUTOMÁTICO"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:backgroundTint="#286B52" />

        <Button
            android:id="@+id/btnManual"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="VOLVER A MODO MANUAL"
            android:layout_marginTop="8dp"
            android:backgroundTint="#46546A" />

        <TextView
            android:id="@+id/txtEstadoMotor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motor: detenido"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>
