<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101B2D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTROLGIRO"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTROL POR BLUETOOTH BLE"
            android:textColor="#B7C7DD"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnConectar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="BUSCAR Y CONECTAR POR BLE"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:backgroundTint="#286B52" />

        <ImageView
            android:id="@+id/imgBarcelona"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/barca"
            android:contentDescription="Escudo del FC Barcelona"
            android:scaleType="fitCenter"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtConexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bluetooth BLE: desconectado"
            android:textColor="#FFCC80"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="12dp"
            android:background="#25364F"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISTANCIA DEL SENSOR"
            android:textColor="#B7C7DD"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/txtDistancia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="--- cm"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="24dp"
            android:background="#25364F"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTROL MANUAL"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnIzquierda"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="← IZQUIERDA"
                android:textSize="12sp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#174E83" />

            <Button
                android:id="@+id/btnDerecha"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="DERECHA →"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#174E83" />

        </LinearLayout>

        <Button
            android:id="@+id/btnDetener"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="■ DETENER MOTOR"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:backgroundTint="#A52643" />

        <Button
            android:id="@+id/btnAutomatico"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ACTIVAR MODO AUTOMÁTICO"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:backgroundTint="#286B52" />

        <Button
            android:id="@+id/btnManual"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="VOLVER A MODO MANUAL"
            android:layout_marginTop="8dp"
            android:backgroundTint="#46546A" />

        <TextView
            android:id="@+id/txtEstadoMotor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motor: detenido"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
